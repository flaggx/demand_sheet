# Project URL — Dashboard → Project Settings → API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public key (set ONE — recommended first):
# NEW: API Keys tab → Publishable key (sb_publishable_...)
# https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LEGACY (optional): Legacy API Keys tab → anon — still supported during migration
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
